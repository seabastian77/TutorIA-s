PORT=3000
DATABASE_URL=postgresql://usuario:contrasena@host:puerto/nombre_bd
JWT_SECRET=cambia_esta_clave_por_una_segura
GROQ_API_KEY=tu_clave_de_groq_aqui
SENTRY_DSN=
PEXELS_API_KEY=

# Recuperar contraseña. Sin ninguno de los dos, el enlace se imprime en los
# logs en vez de enviarse; la app funciona igual.
URL_FRONTEND=https://tutorias-frontend-production.up.railway.app
# Gmail le llega a cualquiera. La clave es de APLICACIÓN, no la del correo.
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
# Resend es la alternativa; sin dominio propio solo envía a tu propio correo.
RESEND_API_KEY=
CORREO_REMITENTE=

# Entrar con Google. Sin esto, el botón no aparece y se entra con contraseña.
GOOGLE_CLIENT_ID=

# Voces de Google Cloud. Sin esto lee la voz del navegador.
GOOGLE_TTS_API_KEY=

# Correos (separados por coma) que pueden ver las métricas del estudio; esas cuentas no cuentan como estudiantes
ADMIN_CORREOS=
